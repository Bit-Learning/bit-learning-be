meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "display_name": "Bit Learner"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("access_token", res.body.data.access_token);
  }
}

tests {
  test("user is registered", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.access_token).to.be.a("string");
  });
}
